# Keep LF everywhere so gofmt and diffs behave the same on every machine,
# including Windows CI runners that default to core.autocrlf=true.
* text=auto eol=lf
# Captured command output: keep its exact bytes (CRLF, CR progress redraws).
internal/optimize/testdata/dism/*.txt -text
*.exe binary
*.syso binary
*.png binary
*.gif binary
*.ico binary
