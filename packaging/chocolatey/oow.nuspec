<?xml version="1.0" encoding="utf-8"?>
<!--
  Template, not published: see packaging/README.md.
  The version is set when packing, so this file stays valid XML:
    choco pack packaging\chocolatey\oow.nuspec --version <VERSION>
  Fill <URL> and <SHA256> in tools\chocolateyinstall.ps1 first.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>oow</id>
    <version>0.0.0</version>
    <title>out-of-windows (oow)</title>
    <authors>Harshul Rathod</authors>
    <projectUrl>https://github.com/Harshul1484/out-of-windows</projectUrl>
    <licenseUrl>https://github.com/Harshul1484/out-of-windows/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/Harshul1484/out-of-windows</projectSourceUrl>
    <bugTrackerUrl>https://github.com/Harshul1484/out-of-windows/issues</bugTrackerUrl>
    <tags>cleanup disk uninstaller maintenance cli</tags>
    <summary>Windows-native system maintenance from the terminal.</summary>
    <description>oow cleans temporary files and caches, uninstalls apps with their own uninstallers and reviews what they leave behind, analyzes disk usage and shows live system status. Every destructive action is previewed, explained, confirmed and verified.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
